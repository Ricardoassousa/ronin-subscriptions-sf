{% extends 'base.html.twig' %}

{% block title %}Payment Successful{% endblock %}

{% block body %}

{# ===========================
   Page Header
   =========================== #}
<div class="mb-4 text-center">
    <h2 class="fw-bold mb-1" style="color:#000000; font-size:1.75rem;">
        Payment Successfully Processed
    </h2>
    <div class="text-muted small">
        Thank you! Your transaction has been completed.
    </div>
</div>

{# ===========================
   Flash Messages
   =========================== #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} shadow-sm text-center">{{ message }}</div>
    {% endfor %}
{% endfor %}

{# ===========================
   Payment Details Card
   =========================== #}
<div class="mx-auto" style="max-width: 700px;">

    <div class="p-4 rounded-4"
         style="background: rgba(255,255,255,0.55);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255,255,255,0.4);">

        <h5 class="fw-semibold mb-3">Payment Details</h5>
        <p class="text-muted small">Below are the details of your transaction.</p>

        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Transaction ID:</strong>
                <p>{{ payment.transactionId }}</p>
            </div>
            <div class="col-md-6">
                <strong>Amount Paid:</strong>
                <p>${{ payment.amount|number_format(2, '.', ',') }}</p>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Subscription Plan:</strong>
                <p>{{ payment.subscription.subscriptionPlan.name }}</p>
            </div>
            <div class="col-md-6">
                <strong>Billing Period:</strong>
                <p>{{ payment.subscription.subscriptionPlan.billingLabel }}</p>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Invoice Number:</strong>
                <p>{{ invoiceNumber }}</p>
            </div>
            <div class="col-md-6">
                <strong>Payment Status:</strong>
                <p class="text-success">Successful</p>
            </div>
        </div>

        <div class="d-grid mt-3">
            <a href="{{ path('payments_history') }}" class="btn btn-custom">
                <i class="bi bi-clock-history me-1"></i>
                Go to Payment History
            </a>
        </div>

    </div>
</div>

{% endblock %}