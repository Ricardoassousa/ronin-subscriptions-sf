{% extends 'base.html.twig' %}

{% block title %}Ronin Subscriptions{% endblock %}

{% block body %}
<div class="d-flex flex-column min-vh-100 justify-content-center align-items-center bg-light text-center p-3">

    {# Hero Section #}
    <h1 class="fw-bold mb-3" style="color:#000000; font-size:2.5rem;">
        Welcome to Ronin Subscriptions
    </h1>
    <p class="lead mb-4 text-muted">
        Manage your subscriptions seamlessly and effortlessly.
    </p>

    {# Call-to-Actions #}
    <div class="d-flex gap-3 flex-wrap justify-content-center">
        <a href="{{ path('app_register') }}" class="btn btn-lg fw-semibold"
           style="background:#000000; color:#fff; border-radius:0.375rem; border:none; transition: all 0.2s;"
           onmouseover="this.style.background='#333333';"
           onmouseout="this.style.background='#000000';">
            Get Started
        </a>
        <a href="{{ path('app_login') }}" class="btn btn-outline-secondary btn-lg fw-semibold">
            Login
        </a>
    </div>

    {# Optional footer text #}
    <p class="text-muted mt-5" style="max-width:500px;">
        Ronin Subscriptions helps you organize and track all your subscription plans in one place. Simple, secure, and fast.
    </p>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}