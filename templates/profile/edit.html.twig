{% extends 'base.html.twig' %}

{% block title %}Edit Profile{% endblock %}

{% block body %}

{# ===========================
   Page Header
   =========================== #}
<div class="mb-4 text-center">
    <h2 class="fw-bold mb-1">
        Edit Profile
    </h2>
    <div class="text-muted small">
        Update your account credentials
    </div>
</div>

{# ===========================
   Flash Messages
   =========================== #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} shadow-sm">{{ message }}</div>
    {% endfor %}
{% endfor %}

{# ===========================
   Form Container (centered)
   =========================== #}
<div class="mx-auto" style="max-width: 420px;">

    <div class="p-4 rounded-4"
         style="background: rgba(255,255,255,0.55);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255,255,255,0.4);">

        {{ form_start(profileForm) }}

        {# Email (disabled) #}
        <div class="mb-3">
            <label class="form-label small text-muted">Email</label>
            {{ form_widget(profileForm.email, {
                'attr': {
                    'class': 'form-control',
                    'disabled': 'disabled'
                }
            }) }}
        </div>

        {# New Password #}
        <div class="mb-3">
            <label class="form-label small text-muted">New Password</label>
            {{ form_widget(profileForm.password.first, {
                'attr': {
                    'class': 'form-control ' ~ (profileForm.password.first.vars.errors|length ? 'is-invalid' : '')
                }
            }) }}
            {% for error in profileForm.password.first.vars.errors %}
                <div class="invalid-feedback d-block">
                    {{ error.message }}
                </div>
            {% endfor %}
        </div>

        {# Confirm Password #}
        <div class="mb-3">
            <label class="form-label small text-muted">Confirm Password</label>
            {{ form_widget(profileForm.password.second, {
                'attr': {
                    'class': 'form-control ' ~ (profileForm.password.second.vars.errors|length ? 'is-invalid' : '')
                }
            }) }}
            {% for error in profileForm.password.second.vars.errors %}
                <div class="invalid-feedback d-block">
                    {{ error.message }}
                </div>
            {% endfor %}
        </div>

        {# Submit #}
        <div class="d-grid mt-3">
            <button type="submit" class="btn btn-custom">
                <i class="bi bi-check-lg me-1"></i>
                Save Changes
            </button>
        </div>

        {{ form_end(profileForm) }}

    </div>

</div>

{% endblock %}