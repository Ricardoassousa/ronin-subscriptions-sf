{% extends 'base.html.twig' %}

{% block title %}Customer Profile{% endblock %}

{% block body %}

{# ===========================
   Page Header
   =========================== #}
<div class="mb-4">
    <h2 class="fw-bold mb-1">
        Customer Profile
    </h2>

    <div class="text-muted small">
        {{ user.email ?? '' }}
    </div>
</div>

{# ===========================
   Flash Messages
   =========================== #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} shadow-sm">{{ message }}</div>
    {% endfor %}
{% endfor %}

{# ===========================
   Profile Form
   =========================== #}
<div class="p-4 rounded-4"
     style="background: rgba(255,255,255,0.55);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.4);">

    {{ form_start(form) }}

    <div class="row g-3">

        {% for field in form %}
            {% if field.vars.name != '_token' %}

                <div class="col-12">

                    {# Label #}
                    <label class="form-label small text-muted">
                        {{ form_label(field) }}
                    </label>

                    {# Input #}
                    {{ form_widget(field, {
                        'attr': {
                            'class':
                                (field.vars.block_prefixes[1] == 'choice'
                                    ? 'form-select'
                                    : 'form-control')
                                ~ (field.vars.errors|length ? ' is-invalid' : '')
                        }
                    }) }}

                    {# Errors #}
                    {% for error in field.vars.errors %}
                        <div class="invalid-feedback d-block">
                            {{ error.message }}
                        </div>
                    {% endfor %}

                </div>

            {% endif %}
        {% endfor %}

    </div>

    {# Submit #}
    <div class="mt-4 d-flex justify-content-end">

        <button type="submit" class="btn btn-custom px-4">
            <i class="bi bi-check-lg me-1"></i>
            Save Changes
        </button>

    </div>

    {{ form_end(form) }}

</div>

{% endblock %}