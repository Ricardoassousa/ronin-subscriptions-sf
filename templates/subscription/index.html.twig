{% extends 'base.html.twig' %}

{% block title %}Subscription Plans{% endblock %}

{% block body %}
<div class="bg-light d-flex justify-content-center align-items-start min-vh-100 p-3">
    <div class="w-100" style="max-width: 1200px;">

        <h2 class="text-center mb-5 fw-bold" style="color:#000000; font-size:1.75rem;">
            Subscription Plans
        </h2>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {# Comparison Table of Plans #}
        <div class="table-responsive mb-4">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Plan Name</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Trial Days</th>
                        <th>Billing Interval</th>
                        <th>Discount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for subscriptionPlan in pagination %}
                    <tr>
                        <td>{{ subscriptionPlan.name }}</td>
                        <td>{{ subscriptionPlan.description ?? 'No description available' }}</td>
                        <td>
                            {% if subscriptionPlan.discountPercent %}
                                <span class="text-muted text-decoration-line-through">
                                    {{ subscriptionPlan.price | number_format(2, '.', ',') }} {{ subscriptionPlan.currency }}
                                </span>&nbsp;
                                <span class="text-danger">
                                    {{ (subscriptionPlan.price - (subscriptionPlan.price * subscriptionPlan.discountPercent / 100)) | number_format(2, '.', ',') }} {{ subscriptionPlan.currency }}
                                </span>
                            {% else %}
                                {{ subscriptionPlan.price | number_format(2, '.', ',') }} {{ subscriptionPlan.currency }}
                            {% endif %}
                        </td>
                        <td>{{ subscriptionPlan.trialDays ?? 0 }}</td>
                        <td>{{ subscriptionPlan.billingInterval }}</td>
                        <td>
                            {% if subscriptionPlan.discountPercent %}
                                {{ subscriptionPlan.discountPercent }}% off
                            {% else %}
                                No Discount
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex gap-2 justify-content-center">
                                {% if currentSubscription and currentSubscription.subscriptionPlan.id == subscriptionPlan.id %}
                                    {# Always show Current Plan for the subscribed plan #}
                                    <button class="btn btn-secondary btn-sm" disabled>Current Plan</button>
                                {% elseif not currentSubscription %}
                                    {# No subscription yet, show Subscribe button #}
                                    <form action="{{ path('subscription_subscribe', { planId: subscriptionPlan.id }) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('subscribe' ~ subscriptionPlan.id) }}">
                                        <button class="btn btn-outline-primary btn-sm">Subscribe</button>
                                    </form>
                                {% else %}
                                    {# User has a different subscription, show Change Plan button #}
                                    <form action="{{ path('subscription_change_plan', { id: currentSubscription.id, planId: subscriptionPlan.id }) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('change_plan' ~ currentSubscription.id) }}">
                                        <button class="btn btn-outline-primary btn-sm">Change Plan</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Subscription Status Indicators #}
        <h3 class="text-center mb-4">Your Current Subscription</h3>
        <div class="row g-4">
            {% if currentSubscription %}
                <div class="col-12">
                    <div class="card border-{{ currentSubscription.status == 'active' ? 'success' : 'secondary' }} shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Current Plan: {{ currentSubscription.subscriptionPlan.name }}</h5>
                            <p class="card-text">Status:
                                {% if currentSubscription.status == 'active' %}
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Active
                                    </span>
                                {% elseif currentSubscription.status == 'paused' %}
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-pause-circle"></i> Paused
                                    </span>
                                {% elseif currentSubscription.status == 'cancelled' %}
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-x-circle"></i> Cancelled
                                    </span>
                                {% elseif currentSubscription.status == 'expired' %}
                                    <span class="badge bg-danger">
                                        <i class="bi bi-exclamation-circle"></i> Expired
                                    </span>
                                {% elseif currentSubscription.status == 'past_due' %}
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-bell"></i> Payment Due
                                    </span>
                                {% endif %}
                            </p>

                            {# Conditional actions based on subscription status #}
                            {% if currentSubscription.status == 'active' %}
                                <p class="text-muted">Next Billing: {{ currentSubscription.nextBillingAt|date('d/m/Y') }}</p>
                                <div class="d-flex gap-3">
                                    <form action="{{ path('subscription_pause', { id: currentSubscription.id }) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('pause' ~ currentSubscription.id) }}">
                                        <button class="btn btn-warning btn-sm">Pause Subscription</button>
                                    </form>
                                    <form action="{{ path('subscription_cancel', { id: currentSubscription.id }) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ currentSubscription.id) }}">
                                        <button class="btn btn-outline-danger btn-sm">Cancel Subscription</button>
                                    </form>
                                </div>
                            {% elseif currentSubscription.status == 'paused' %}
                                <div class="d-flex gap-3">
                                    <form action="{{ path('subscription_resume', { id: currentSubscription.id }) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('resume' ~ currentSubscription.id) }}">
                                        <button class="btn btn-success btn-sm">Resume Subscription</button>
                                    </form>
                                    <form action="{{ path('subscription_cancel', { id: currentSubscription.id }) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ currentSubscription.id) }}">
                                        <button class="btn btn-outline-danger btn-sm">Cancel Subscription</button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info text-center">You currently don't have a subscription.</div>
                </div>
            {% endif %}
        </div>

        {# Pagination #}
        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(pagination) }}
        </div>

    </div>
</div>
{% endblock %}