{% extends 'base.html.twig' %}

{% block title %}Subscription Plans{% endblock %}

{% block body %}
<div class="bg-light d-flex justify-content-center align-items-start min-vh-100 p-3">
    <div class="w-100" style="max-width: 1200px;">

        <h2 class="text-center mb-5 fw-bold" style="color:#000000; font-size:1.75rem;">
            Subscription Plans
        </h2>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="row g-4">
            {% for subscriptionPlan in pagination %}
                {% set isCurrent = currentSubscription and currentSubscription.subscriptionPlan and currentSubscription.subscriptionPlan.id == subscriptionPlan.id %}

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm rounded-4 {% if isCurrent %}border border-primary{% endif %}">
                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title fw-bold">{{ subscriptionPlan.name }}</h5>
                            <p class="text-muted small mb-2">{{ subscriptionPlan.description ?? 'No description available' }}</p>

                            <p class="fw-bold mb-2">
                                {% if subscriptionPlan.discountPercent and subscriptionPlan.discountPercent > 0 %}
                                    <span class="text-muted text-decoration-line-through small">
                                        ${{ subscriptionPlan.price|number_format(2, '.', ',') }}
                                    </span>
                                    <span class="text-danger ms-2">
                                        ${{ (subscriptionPlan.price - (subscriptionPlan.price * subscriptionPlan.discountPercent / 100))|number_format(2, '.', ',') }}
                                    </span>
                                {% else %}
                                    ${{ subscriptionPlan.price|number_format(2, '.', ',') }}
                                {% endif %}
                            </p>

                            <p class="small mb-2">{{ subscriptionPlan.billingLabel }}</p>
                            {% if loop.first %}<span class="badge bg-success mb-2">Most Popular</span>{% endif %}

                            <div class="mt-auto d-grid gap-2">

                                {# ---------------- Current Plan ---------------- #}
                                {% if isCurrent %}
                                    {% if currentSubscription.status == 'active' %}
                                        <button class="btn btn-secondary w-100" disabled>Current Plan</button>
                                        {% if currentSubscription.nextBillingAt %}
                                            <small class="text-muted text-center">Next billing: {{ currentSubscription.nextBillingAt|date('d/m/Y') }}</small>
                                        {% endif %}

                                        <form action="{{ path('subscription_pause', { id: currentSubscription.id }) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('pause' ~ currentSubscription.id) }}">
                                            <button class="btn btn-warning w-100">Pause Subscription</button>
                                        </form>

                                        <form action="{{ path('subscription_cancel', { id: currentSubscription.id }) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ currentSubscription.id) }}">
                                            <button class="btn btn-outline-danger w-100">Cancel Subscription</button>
                                        </form>

                                    {% elseif currentSubscription.status == 'paused' %}
                                        <button class="btn btn-warning w-100" disabled>Paused</button>

                                        <form action="{{ path('subscription_resume', { id: currentSubscription.id }) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('resume' ~ currentSubscription.id) }}">
                                            <button class="btn btn-success w-100">Resume Subscription</button>
                                        </form>

                                        <form action="{{ path('subscription_cancel', { id: currentSubscription.id }) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ currentSubscription.id) }}">
                                            <button class="btn btn-outline-danger w-100">Cancel Subscription</button>
                                        </form>

                                    {% elseif currentSubscription.status == 'cancelled' %}
                                        <button class="btn btn-secondary w-100" disabled>Cancelled</button>
                                    {% endif %}

                                {% else %}
                                    {# ---------------- Subscribe / Switch Plan ---------------- #}
                                    {% if currentSubscription %}
                                        <form action="{{ path('subscription_change_plan', { id: currentSubscription.id, planId: subscriptionPlan.id }) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('change_plan' ~ currentSubscription.id) }}">
                                            <button class="btn btn-outline-primary w-100">Switch Plan</button>
                                        </form>
                                    {% else %}
                                        <form action="{{ path('subscription_subscribe', { planId: subscriptionPlan.id }) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('subscribe' ~ subscriptionPlan.id) }}">
                                            <button class="btn btn-primary w-100">Subscribe</button>
                                        </form>
                                    {% endif %}
                                {% endif %}

                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info text-center">No subscription plans available.</div>
                </div>
            {% endfor %}
        </div>

        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(pagination) }}
        </div>

    </div>
</div>
{% endblock %}