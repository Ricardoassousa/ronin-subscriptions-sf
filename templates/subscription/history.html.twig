{% extends 'base.html.twig' %}

{% block title %}Subscription History{% endblock %}

{% block body %}
<div class="bg-light d-flex justify-content-center align-items-start min-vh-100 p-3">
    <div class="w-100" style="max-width: 1200px;">

        <h2 class="text-center mb-5 fw-bold" style="color:#000000; font-size:1.75rem;">
            Subscription History
        </h2>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mb-3 text-center">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th scope="col">Subscription Plan</th>
                        <th scope="col">Status</th>
                        <th scope="col">Start Date</th>
                        <th scope="col">End Date</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for subscription in pagination %}
                        <tr>
                            <td class="text-center">{{ subscription.subscriptionPlan.name }}</td>
                            <td class="text-center">
                                {% if subscription.status == 'ACTIVE' %}
                                    <span class="badge bg-success">{{ subscription.status|capitalize }}</span>
                                {% elseif subscription.status == 'CANCELLED' %}
                                    <span class="badge bg-danger">{{ subscription.status|capitalize }}</span>
                                {% elseif subscription.status == 'PAUSED' %}
                                    <span class="badge bg-warning text-dark">{{ subscription.status|capitalize }}</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ subscription.status|capitalize }}</span>
                                {% endif %}
                            </td>
                            <td class="text-center">{{ subscription.startedAt|date('d/m/Y') }}</td>
                            <td class="text-center">
                                {% if subscription.endsAt %}
                                    {{ subscription.endsAt|date('d/m/Y') }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td class="text-center">
                                {% if subscription.status == 'ACTIVE' %}
                                    <a href="{{ path('subscription_change_plan', { id: subscription.id }) }}" class="btn btn-sm btn-outline-warning">Change Plan</a>
                                    <a href="{{ path('subscription_cancel', { id: subscription.id }) }}" class="btn btn-sm btn-outline-danger">Cancel</a>
                                {% elseif subscription.status == 'PAUSED' %}
                                    <a href="{{ path('subscription_resume', { id: subscription.id }) }}" class="btn btn-sm btn-outline-success">Resume</a>
                                {% elseif subscription.status == 'CANCELLED' %}
                                    -
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">No subscriptions found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Pagination links #}
        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(pagination) }}
        </div>

    </div>
</div>
{% endblock %}