{% extends 'emails/base_email.html.twig' %}

{% block title %}Upcoming Renewal Reminder{% endblock %}

{% block body %}
    <h2 class="mb-3">Your subscription is renewing soon ⏳</h2>

    <p>
        Hello 
        <strong>
            {{ subscription.user?.customerProfile?.firstName ?? 'Customer' }}
        </strong>,
    </p>

    <p>
        This is a friendly reminder that your subscription will renew shortly.
        Below are the details of your upcoming billing:
    </p>

    <h4 class="my-4">Subscription Details</h4>

    <p>
        Subscription No. <strong>#{{ subscription.id }}</strong><br>
        Plan: <strong>{{ subscription.subscriptionPlan?.name ?? 'N/A' }}</strong><br>
        Status: <strong>{{ subscription.status|capitalize }}</strong>
    </p>

    <h4 class="my-4">Billing Information</h4>

    <p>
        Amount:
        <strong>
            {{ subscription.getCurrentPrice()|number_format(2, '.', ',') }}
            {{ subscription.currencySnapshot }}
        </strong><br>

        Billing Interval:
        <strong>{{ subscription.billingIntervalSnapshot|capitalize }}</strong><br>

        Next Billing Date:
        <strong>
            {{ subscription.nextBillingAt 
                ? subscription.nextBillingAt|date('F j, Y') 
                : 'N/A' 
            }}
        </strong>
    </p>

    {% if subscription.discountPercentSnapshot is not null %}
        <p>
            Discount applied:
            <strong>{{ subscription.discountPercentSnapshot }}%</strong>
        </p>
    {% endif %}

    <hr class="my-4">

    <p>
        If you wish to make any changes to your subscription or billing details,
        please do so before the renewal date.
    </p>

    <p>
        If you have any questions, feel free to contact our support team.
    </p>

    <p class="mt-4">
        Thank you for being with us
    </p>
{% endblock %}