<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Ronin Subscriptions{% endblock %}</title>

    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
/* ===== Base ===== */
body {
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;

    background:
        radial-gradient(circle at 10% 20%, #eef2ff, transparent 40%),
        radial-gradient(circle at 90% 0%, #e0f7fa, transparent 40%),
        #f8fafc;
}

/* ===== Navbar ===== */
.navbar {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(0,0,0,0.05);

    position: sticky;
    top: 0;
    z-index: 1050;
}

.navbar-brand {
    font-weight: 600;
    color: #111 !important;
}

/* ===== User badge ===== */
.user-badge {
    background: rgba(0,0,0,0.05);
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.85rem;
}

/* ===== Menu button ===== */
.btn-menu {
    background: rgba(0,0,0,0.05);
    border: 1px solid rgba(0,0,0,0.08);
    color: #222;
    border-radius: 10px;
    padding: 6px 14px;
    transition: all 0.2s ease;
}

.btn-menu:hover {
    background: rgba(0,0,0,0.08);
}

/* ===== Dropdown ===== */
.dropdown-menu {
    border: none;
    border-radius: 14px;
    padding: 8px;

    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(12px);

    box-shadow:
        0 12px 40px rgba(0,0,0,0.10),
        0 3px 12px rgba(0,0,0,0.05);
}

.dropdown-item {
    border-radius: 10px;
    padding: 8px 12px;
    font-weight: 500;
}

.dropdown-item:hover {
    background: rgba(13, 202, 240, 0.12);
}

/* ===== Main container ===== */
.main-container {
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(12px);

    border-radius: 20px;
    padding: 28px;

    border: 1px solid rgba(255,255,255,0.6);

    box-shadow:
        0 12px 40px rgba(0,0,0,0.08),
        0 3px 12px rgba(0,0,0,0.04);

    transition: all 0.2s ease;
}

.main-container:hover {
    transform: translateY(-2px);
}

/* ===== Buttons ===== */
.btn-custom {
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 500;

    background: linear-gradient(135deg, #0dcaf0, #0aa2c0);
    border: none;
    color: white;

    transition: all 0.2s ease;
}

.btn-custom:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(13, 202, 240, 0.3);
}

/* ===== Footer ===== */
footer {
    margin-top: auto;
    opacity: 0.6;
    font-size: 0.8rem;
}
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg">
    <div class="container-fluid px-3 px-lg-4">

        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('homepage') }}">
            <i class="bi bi-kanban"></i>
            Ronin
        </a>

        <!-- Mobile toggle -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Menu -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-2 mt-3 mt-lg-0">

                {% if app.user %}
                    <!-- User -->
                    <li class="nav-item">
                        <span class="user-badge d-flex align-items-center gap-2">
                            <i class="bi bi-person-circle"></i>
                            {{ app.user.userIdentifier }}
                        </span>
                    </li>

                    <!-- Dropdown -->
                    <li class="nav-item dropdown">
                        <button class="btn-menu d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                            <i class="bi bi-grid"></i>
                            <span class="d-none d-md-inline">Menu</span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <!-- Frontoffice -->
                            <li>
                                <a class="dropdown-item" href="{{ path('subscription_index') }}">
                                    <i class="bi bi-card-list me-2"></i> Subscriptions
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="{{ path('app_customer_profile') }}">
                                    <i class="bi bi-person me-2"></i> My Profile
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="{{ path('app_profile') }}">
                                    <i class="bi bi-gear me-2"></i> Settings
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="{{ path('payments_history') }}">
                                    <i class="bi bi-credit-card me-2"></i> Payments
                                </a>
                            </li>

                            {% if is_granted('ROLE_ADMIN') %}
                                <li><hr class="dropdown-divider"></li>

                                <!-- Admin -->
                                <li>
                                    <a class="dropdown-item" href="{{ path('admin_users_index') }}">
                                        <i class="bi bi-people me-2"></i> Users
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="{{ path('subscription_plan_index') }}">
                                        <i class="bi bi-tags me-2"></i> Subscription Plans
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="{{ path('admin_dashboard') }}">
                                        <i class="bi bi-speedometer2 me-2"></i> Admin Dashboard
                                    </a>
                                </li>
                            {% endif %}

                            <li><hr class="dropdown-divider"></li>

                            <!-- Logout -->
                            <li>
                                <form action="{{ path('app_logout') }}" method="post">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                                    </button>
                                </form>
                            </li>

                        </ul>
                    </li>

                {% else %}
                    <li class="nav-item">
                        <a class="btn btn-sm btn-outline-dark" href="{{ path('app_login') }}">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                    </li>
                {% endif %}

            </ul>
        </div>
    </div>
</nav>

<!-- Main -->
<main class="container py-3 py-md-4 flex-grow-1">
    <div class="main-container">
        {% block body %}{% endblock %}
    </div>
</main>

<!-- Footer -->
<footer class="text-center text-muted small py-3">
    © {{ "now"|date("Y") }} Ronin Subscriptions
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>