<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Ronin Subscriptions{% endblock %}</title>

    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        /* ===== Base ===== */
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: radial-gradient(circle at 20% 20%, #eef2ff, transparent 40%),
                        radial-gradient(circle at 80% 0%, #e0f7fa, transparent 40%),
                        #f8fafc;
        }

        /* ===== Navbar (glass effect) ===== */
        .navbar {
            background: rgba(31, 31, 31, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .navbar-brand {
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .nav-link {
            transition: all 0.2s ease;
            opacity: 0.85;
        }

        .nav-link:hover {
            opacity: 1;
            color: #0dcaf0 !important;
        }

        /* ===== User badge ===== */
        .user-badge {
            background: rgba(255,255,255,0.1);
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 0.9rem;
        }

        /* ===== Main container (card style) ===== */
        .main-container {
            background: rgba(255,255,255,0.75);
            backdrop-filter: blur(8px);
            border-radius: 18px;
            padding: 22px;
            box-shadow:
                0 10px 30px rgba(0,0,0,0.08),
                0 2px 10px rgba(0,0,0,0.03);
            border: 1px solid rgba(255,255,255,0.4);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        /* Subtle hover lift */
        .main-container:hover {
            transform: translateY(-2px);
            box-shadow:
                0 14px 40px rgba(0,0,0,0.10),
                0 4px 15px rgba(0,0,0,0.05);
        }

        @media (min-width: 768px) {
            .main-container {
                padding: 30px;
            }
        }

        /* ===== Buttons ===== */
        .btn-custom {
            border-radius: 12px;
            padding: 8px 18px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .btn-custom:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(0,0,0,0.1);
        }

        /* ===== Footer ===== */
        footer {
            margin-top: auto;
            opacity: 0.7;
        }

        /* ===== Small screen tweaks ===== */
        @media (max-width: 576px) {
            .main-container {
                padding: 18px;
                border-radius: 14px;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid px-3 px-lg-4">

            <!-- Brand -->
            <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                <i class="bi bi-kanban"></i>
                Ronin
            </a>

            <!-- Mobile toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menu -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-2 mt-3 mt-lg-0">

                    {% if app.user %}
                        <li class="nav-item">
                            <span class="nav-link user-badge d-inline-flex align-items-center gap-1">
                                <i class="bi bi-person-circle"></i>
                                <span class="d-none d-sm-inline">
                                    {{ app.user.userIdentifier }}
                                </span>
                            </span>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1" href="{{ path('app_logout') }}">
                                <i class="bi bi-box-arrow-right"></i>
                                Logout
                            </a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1" href="{{ path('app_login') }}">
                                <i class="bi bi-box-arrow-in-right"></i>
                                Login
                            </a>
                        </li>
                    {% endif %}

                </ul>
            </div>
        </div>
    </nav>

    <!-- Main -->
    <main class="container py-3 py-md-4 flex-grow-1">
        <div class="main-container">
            {% block body %}{% endblock %}
        </div>
    </main>

    <!-- Footer -->
    <footer class="text-center text-muted small py-3">
        © {{ "now"|date("Y") }} Ronin Subscriptions
    </footer>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}{% endblock %}
</body>
</html>