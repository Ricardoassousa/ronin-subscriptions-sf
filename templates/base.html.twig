<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Ronin Subscriptions{% endblock %}</title>

    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('css/app.css') }}">

    <style>
/* ===== Base ===== */
body {
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;

    background:
        radial-gradient(circle at 15% 20%, rgba(13, 202, 240, 0.15), transparent 40%),
        radial-gradient(circle at 85% 0%, rgba(111, 66, 193, 0.15), transparent 40%),
        linear-gradient(180deg, #f1f5f9 0%, #e9eef5 100%);

    color: #1e293b;
}

/* ===== Navbar ===== */
.navbar {
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(0,0,0,0.06);
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);

    position: sticky;
    top: 0;
    z-index: 1050;
}

.navbar-brand {
    font-weight: 600;
    color: #0f172a !important;
}

/* ===== User badge ===== */
.user-badge {
    background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(13,202,240,0.15));
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
}

/* ===== Menu button ===== */
.btn-menu {
    background: rgba(0,0,0,0.05);
    border: 1px solid rgba(0,0,0,0.08);
    color: #222;
    border-radius: 12px;
    padding: 6px 14px;
}

.btn-menu:hover {
    background: rgba(0,0,0,0.08);
}

/* ===== Dropdown ===== */
.dropdown-menu {
    border: none;
    border-radius: 16px;
    padding: 10px;

    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(16px);

    box-shadow:
        0 20px 50px rgba(0,0,0,0.12),
        0 6px 18px rgba(0,0,0,0.06);
}

.dropdown-item {
    border-radius: 10px;
    padding: 10px 14px;
    font-weight: 500;
    color: #1e293b;
}

.dropdown-item:hover {
    background: rgba(99, 102, 241, 0.12);
}

.dropdown-item.active {
    background: linear-gradient(135deg, #6366f1, #0dcaf0);
    color: white;
}

/* ===== Main container ===== */
.main-container {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(16px);

    border-radius: 20px;
    padding: 28px;

    border: 1px solid rgba(255,255,255,0.4);

    box-shadow:
        0 20px 60px rgba(0,0,0,0.08),
        0 8px 24px rgba(0,0,0,0.05);

    transition: all 0.25s ease;
}

.main-container:hover {
    transform: translateY(-3px);
}

/* ===== Alerts ===== */
.alert {
    border-radius: 12px;
}

/* ===== Footer ===== */
footer {
    margin-top: auto;
    opacity: 0.6;
    font-size: 0.8rem;
}

/* ===== Micro-interactions ===== */
* {
    transition: all 0.2s ease;
}

a {
    text-decoration: none;
}
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

{% set currentRoute = app.request.get('_route') %}

<!-- Navbar -->
<nav class="navbar navbar-expand-lg" role="navigation" aria-label="Main navigation">
    <div class="container-fluid px-3 px-lg-4">

        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('homepage') }}">
            <i class="bi bi-kanban"></i>
            Ronin
        </a>

        <!-- Mobile toggle -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Menu -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-2 mt-3 mt-lg-0">

                {% if app.user %}
                    <!-- User -->
                    <li class="nav-item">
                        <span class="user-badge d-flex align-items-center gap-2">
                            <i class="bi bi-person-circle"></i>
                            {{ app.user.userIdentifier }}
                        </span>
                    </li>

                    <!-- Dropdown -->
                    <li class="nav-item dropdown">
                        <button class="btn-menu d-flex align-items-center gap-2 px-3 py-2"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <i class="bi bi-grid"></i>
                            <span>Menu</span>
                        </button>

                        {% include 'partials/_user_menu.html.twig' %}
                    </li>

                {% else %}
                    <li class="nav-item">
                        <a class="btn btn-sm btn-outline-dark"
                           href="{{ path('app_login') }}">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-sm btn-outline-primary"
                           href="{{ path('app_register') }}">
                            <i class="bi bi-person-plus"></i> Register
                        </a>
                    </li>
                {% endif %}

            </ul>
        </div>
    </div>
</nav>

<!-- Main -->
<main class="container py-3 py-md-4 flex-grow-1">
    {% block main_container %}
        <div class="main-container">
            {% block body %}{% endblock %}
        </div>
    {% endblock %}
</main>

<!-- Footer -->
<footer class="text-center text-muted small py-3">
    © {{ "now"|date("Y") }} Ronin Subscriptions
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>