{% extends 'base.html.twig' %}

{% block title %}Subscription Plans{% endblock %}

{% block body %}

{# ===========================
   Page Title
   =========================== #}
<h2 class="mb-4 fw-bold">
    Subscription Plans
</h2>

{# ===========================
   Flash Messages
   =========================== #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} shadow-sm">{{ message }}</div>
    {% endfor %}
{% endfor %}

{# ===========================
   Search & Filters
   =========================== #}
<div class="mb-4 p-4 rounded-4"
     style="background: rgba(255,255,255,0.55);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.4);">

    {{ form_start(searchForm) }}

    {# Main search row #}
    <div class="row g-3 align-items-end">

        {# Search input #}
        <div class="col-lg-5">
            <label class="form-label small text-muted">Search</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-0">
                    <i class="bi bi-search"></i>
                </span>
                {{ form_widget(searchForm.search, {
                    'attr': {
                        'class': 'form-control border-0',
                        'placeholder': 'Name or slug...'
                    }
                }) }}
            </div>
        </div>

        {# Billing interval #}
        <div class="col-lg-3">
            <label class="form-label small text-muted">Interval</label>
            {{ form_widget(searchForm.billingInterval, {
                'attr': {'class': 'form-select border-0'}
            }) }}
        </div>

        {# Search button #}
        <div class="col-lg-2 d-grid">
            <button class="btn btn-custom">
                <i class="bi bi-search me-1"></i>
                Search
            </button>
        </div>

        {# Reset button #}
        <div class="col-lg-2 d-grid">
            <a href="{{ path('subscription_plan_index') }}"
               class="btn btn-outline-secondary">
                Reset
            </a>
        </div>

    </div>

    {# Advanced filters #}
    <div class="row g-3 mt-3">

        <div class="col-md-3">
            <label class="form-label small text-muted">Min Price</label>
            {{ form_widget(searchForm.minPrice, {
                'attr': {'class': 'form-control'}
            }) }}
        </div>

        <div class="col-md-3">
            <label class="form-label small text-muted">Max Price</label>
            {{ form_widget(searchForm.maxPrice, {
                'attr': {'class': 'form-control'}
            }) }}
        </div>

        <div class="col-md-3">
            <label class="form-label small text-muted">Min Trial</label>
            {{ form_widget(searchForm.minTrialDays, {
                'attr': {'class': 'form-control'}
            }) }}
        </div>

        <div class="col-md-3">
            <label class="form-label small text-muted">Max Trial</label>
            {{ form_widget(searchForm.maxTrialDays, {
                'attr': {'class': 'form-control'}
            }) }}
        </div>

    </div>

    {# Toggles #}
    <div class="d-flex gap-4 mt-3">

        <div class="form-check">
            {{ form_widget(searchForm.isActive, {'attr': {'class': 'form-check-input'}}) }}
            <label class="form-check-label small">Active only</label>
        </div>

        <div class="form-check">
            {{ form_widget(searchForm.isFeatured, {'attr': {'class': 'form-check-input'}}) }}
            <label class="form-check-label small">Featured</label>
        </div>

    </div>

    {{ form_end(searchForm) }}
</div>

{# ===========================
   Plans Table
   =========================== #}
<div class="table-responsive">
    <table class="table align-middle">

        <thead>
            <tr class="text-muted small">
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Interval</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
        {% for subscriptionPlan in pagination %}
            <tr class="border-top">

                {# ID #}
                <td class="text-muted small">
                    #{{ subscriptionPlan.id }}
                </td>

                {# Name + slug #}
                <td class="fw-semibold">
                    {{ subscriptionPlan.name }}
                    <div class="text-muted small">{{ subscriptionPlan.slug }}</div>
                </td>

                {# Price with discount #}
                <td>
                    {% if subscriptionPlan.discountPercent %}
                        <div class="text-muted small text-decoration-line-through">
                            {{ subscriptionPlan.price|number_format(2) }}€
                        </div>
                        <div class="fw-bold text-danger">
                            {{ (subscriptionPlan.price - (subscriptionPlan.price * subscriptionPlan.discountPercent / 100))|number_format(2) }}€
                        </div>
                    {% else %}
                        <span class="fw-bold">
                            {{ subscriptionPlan.price|number_format(2) }}€
                        </span>
                    {% endif %}
                </td>

                {# Billing interval #}
                <td class="text-muted">
                    {{ subscriptionPlan.billingInterval|capitalize }}
                </td>

                {# Status badge #}
                <td>
                    {% if subscriptionPlan.isActive %}
                        <span class="badge bg-success-subtle text-success px-3 py-2">
                            Active
                        </span>
                    {% else %}
                        <span class="badge bg-secondary-subtle text-muted px-3 py-2">
                            Disabled
                        </span>
                    {% endif %}
                </td>

                {# Actions #}
                <td class="text-end">
                    <div class="d-flex justify-content-end gap-2">

                        <a href="{{ path('subscription_plan_show', { id: subscriptionPlan.id, slug: subscriptionPlan.slug }) }}"
                           class="btn btn-sm btn-outline-primary">
                            View
                        </a>

                        <a href="{{ path('subscription_plan_edit', { id: subscriptionPlan.id }) }}"
                           class="btn btn-sm btn-outline-warning">
                            Edit
                        </a>

                        <form action="{{ path('subscription_plan_toggle', { id: subscriptionPlan.id }) }}"
                              method="post">
                            <input type="hidden" name="_method" value="PATCH">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_status' ~ subscriptionPlan.id) }}">

                            {% if subscriptionPlan.isActive %}
                                <button class="btn btn-sm btn-outline-danger">
                                    Disable
                                </button>
                            {% else %}
                                <button class="btn btn-sm btn-outline-success">
                                    Enable
                                </button>
                            {% endif %}
                        </form>

                    </div>
                </td>

            </tr>

        {% else %}
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    No subscription plans found.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{# ===========================
   Call To Action
   =========================== #}
<div class="mt-4 text-end">
    <a href="{{ path('subscription_plan_new') }}" class="btn btn-custom">
        + Create Plan
    </a>
</div>

{% endblock %}