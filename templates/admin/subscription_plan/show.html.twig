{% extends 'base.html.twig' %}

{% block title %}Subscription Plan Details{% endblock %}

{% block body %}

{# ===========================
   Header
   =========================== #}
<div class="mb-4">
    <h2 class="fw-bold mb-1">
        {{ subscriptionPlan.name }}
    </h2>

    <div class="text-muted small">
        Plan details overview
    </div>
</div>

{# ===========================
   Flash Messages
   =========================== #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} shadow-sm">{{ message }}</div>
    {% endfor %}
{% endfor %}

{# ===========================
   Details Container
   =========================== #}
<div class="p-4 rounded-4"
     style="background: rgba(255,255,255,0.55);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.4);">

    <div class="row g-4">

        {# Price #}
        <div class="col-md-6">
            <div class="text-muted small">Price</div>

            {% if subscriptionPlan.discountPercent and subscriptionPlan.discountPercent > 0 %}
                <div class="text-muted text-decoration-line-through small">
                    {{ subscriptionPlan.price|number_format(2) }} {{ subscriptionPlan.currency }}
                </div>

                <div class="fw-bold fs-5 text-danger">
                    {{ (subscriptionPlan.price - (subscriptionPlan.price * subscriptionPlan.discountPercent / 100))|number_format(2) }} {{ subscriptionPlan.currency }}
                </div>
            {% else %}
                <div class="fw-bold fs-5">
                    {{ subscriptionPlan.price|number_format(2) }} {{ subscriptionPlan.currency }}
                </div>
            {% endif %}
        </div>

        {# Status #}
        <div class="col-md-6">
            <div class="text-muted small">Status</div>

            {% if subscriptionPlan.isActive %}
                <span class="badge bg-success-subtle text-success px-3 py-2">
                    Active
                </span>
            {% else %}
                <span class="badge bg-secondary-subtle text-muted px-3 py-2">
                    Disabled
                </span>
            {% endif %}
        </div>

        {# Description #}
        <div class="col-12">
            <div class="text-muted small mb-1">Description</div>

            <div class="p-3 rounded-3"
                 style="background: rgba(0,0,0,0.03);">

                {{ subscriptionPlan.description ?: 'No description provided.' }}
            </div>
        </div>

    </div>

</div>

{# ===========================
   Actions
   =========================== #}
<div class="mt-4 d-flex flex-column flex-md-row justify-content-between gap-2">

    <a href="{{ path('subscription_plan_index') }}"
       class="btn btn-outline-secondary">
        ← Back to Plans
    </a>

    <a href="{{ path('subscription_plan_edit', { id: subscriptionPlan.id }) }}"
       class="btn btn-custom">
        <i class="bi bi-pencil me-1"></i>
        Edit Plan
    </a>

</div>

{% endblock %}