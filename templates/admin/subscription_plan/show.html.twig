{% extends 'base.html.twig' %}

{% block title %}Subscription Plan Details{% endblock %}

{% block body %}
<div class="bg-light d-flex justify-content-center align-items-center min-vh-100 p-3">
    <div class="card shadow-lg rounded-4 p-4 w-100" style="max-width: 700px; background-color:#ffffff;">

        <h2 class="card-title mb-4 text-center fw-bold" style="color:#000000; font-size:1.75rem;">
            {{ subscriptionPlan.name }}
        </h2>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <ul class="list-group list-group-flush mb-4">
            <li class="list-group-item"><strong>Price:</strong>
                ${{ subscriptionPlan.price|number_format(2, '.', ',') }}
            </li>
            <li class="list-group-item"><strong>Discount Price:</strong>
                {% if subscriptionPlan.discountPercent and subscriptionPlan.discountPercent > 0 %}
                    ${{ subscriptionPlan.discountPrice|number_format(2, '.', ',') }}
                {% else %}
                    <span class="text-muted">No discount</span>
                {% endif %}
            </li>
            <li class="list-group-item"><strong>Active:</strong>
                {{ subscriptionPlan.isActive ? 'Yes' : 'No' }}
            </li>
            <li class="list-group-item"><strong>Description:</strong>
                {{ subscriptionPlan.description }}
            </li>
        </ul>

        <div class="d-grid gap-2">
            <a href="{{ path('subscription_plan_edit', { id: subscriptionPlan.id }) }}"
               class="btn fw-semibold"
               style="
                    background: linear-gradient(90deg,#ffc107 0%,#fd7e14 100%);
                    color:#fff;
                    border:none;
                    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
                    transition: transform 0.1s, box-shadow 0.2s;
               "
               onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 12px rgba(0,0,0,0.15)';"
               onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px rgba(0,0,0,0.1)';">
                Edit Plan
            </a>

            <a href="{{ path('subscription_plan_index') }}"
               class="btn fw-semibold"
               style="
                    background:#ffffff;
                    color:#6f42c1;
                    border:2px solid #6f42c1;
                    border-radius:0.375rem;
                    transition: all 0.2s;
               "
               onmouseover="this.style.background='#6f42c1'; this.style.color='#fff';"
               onmouseout="this.style.background='#ffffff'; this.style.color='#6f42c1';">
                Back to Plans List
            </a>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}