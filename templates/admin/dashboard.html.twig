{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard Overview{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="text-center mb-4">Admin Dashboard Overview</h1>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6>Total Subscriptions</h6>
                <h3>{{ metrics.totalSubscriptions }}</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6>Active</h6>
                <h3>{{ metrics.activeSubscriptions }}</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6>Cancelled</h6>
                <h3>{{ metrics.cancelledSubscriptions }}</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6>MRR ($)</h6>
                {% for currency, amount in metrics.mrr %}
                    <h3><strong>{{ currency }}</strong>: {{ amount|number_format(2, '.', ',') }}</h3>
                {% else %}
                    <div>0.00</div>
                {% endfor %}
            </div>
        </div>
    </div>

    <p class="text-center text-muted mt-4">
        Overview only — KPIs and previews coming soon
    </p>
</div>
{% endblock %}