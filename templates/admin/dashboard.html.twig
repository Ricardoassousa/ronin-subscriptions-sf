{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard Overview{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="text-center mb-4">Admin Dashboard Overview</h1>

    {# ========================== #}
    {# Summary KPIs                #}
    {# ========================== #}
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6>Total Subs</h6>
                <h3>{{ metrics.totalSubscriptions }}</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6>Active</h6>
                <h3>{{ metrics.activeSubscriptions }}</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6>Cancelled</h6>
                <h3>{{ metrics.cancelledSubscriptions }}</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6>MRR ($)</h6>
                {% for currency, amount in metrics.mrr %}
                    <h3><strong>{{ currency }}</strong>: {{ amount|number_format(2, '.', ',') }}</h3>
                {% else %}
                    <div>0.00</div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ========================== #}
    {# Growth Chart (New Subscriptions) #}
    {# ========================== #}
    <div class="row my-4">
        <div class="col-12">
            <h3>New Subscriptions (Growth)</h3>
            <div id="growth-chart-root" style="height: 400px;"></div>
        </div>
    </div>

    {# ========================== #}
    {# Recent Activity Feed       #}
    {# ========================== #}
    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">Recent Activity</h3>
            <div class="card">
                <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                    <ul class="list-group list-group-flush">
                        {% for act in recentActivities %}
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge bg-{{ act.color }} me-2">{{ act.label }}</span>
                                    {{ act.description }}
                                    {% if act.relatedType and act.relatedId %}
                                        <small class="text-muted">
                                            ({{ act.relatedType }} #{{ act.relatedId }})
                                        </small>
                                    {% endif %}
                                </div>
                                <small class="text-muted">{{ act.createdAt|date('Y-m-d H:i') }}</small>
                            </li>
                        {% else %}
                            <li class="list-group-item text-muted">No recent activity.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

{% block stylesheets %}
<style>
    #growth-chart-root {
        width: 100%;
        height: 400px;
    }
</style>
{% endblock %}