{% extends 'base.html.twig' %}

{% block title %}Users List{% endblock %}

{% block body %}

{# ===========================
   Header
   =========================== #}
<div class="mb-4 text-center">
    <h2 class="fw-bold mb-1">Users</h2>
    <div class="text-muted small">Manage registered users</div>
</div>

{# ===========================
   Flash Messages
   =========================== #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} shadow-sm">{{ message }}</div>
    {% endfor %}
{% endfor %}

{# ===========================
   Users List
   =========================== #}
<div class="p-4 rounded-4"
     style="background: rgba(255,255,255,0.55);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.4);">

    {% if pagination|length > 0 %}

        <div class="list-group list-group-flush">

            {% for user in pagination %}
                <div class="list-group-item px-0 py-3 border-top">

                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">

                        {# User info #}
                        <div class="text-break">
                            <div class="fw-semibold">
                                {{ user.email }}
                            </div>

                            <small class="text-muted">
                                {{ user.roles|join(', ') }}
                            </small>
                        </div>

                        {# Actions #}
                        <div class="mt-2 mt-md-0">
                            <a href="{{ path('admin_user_edit', { id: user.id }) }}"
                               class="btn btn-sm btn-outline-primary">
                                Edit roles
                            </a>
                        </div>

                    </div>

                </div>
            {% endfor %}

        </div>

        {# Pagination #}
        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(pagination) }}
        </div>

    {% else %}

        {# Empty state #}
        <div class="text-center text-muted py-4">
            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
            No users found.
        </div>

    {% endif %}

</div>

{# ===========================
   Navigation
   =========================== #}
<div class="mt-4 text-center">
    <a href="{{ path('admin_users_index') }}"
       class="btn btn-outline-secondary">
        ← Back to Management
    </a>
</div>

{% endblock %}