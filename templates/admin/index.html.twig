{% extends 'base.html.twig' %}

{% block title %}Admin Management{% endblock %}

{% block body %}

{# ===========================
   Header
   =========================== #}
<div class="mb-4 text-center">
    <h2 class="fw-bold mb-1">Admin Management</h2>
    <div class="text-muted small">Overview & quick actions</div>
</div>

{# ===========================
   Tabs Navigation
   =========================== #}
<ul class="nav nav-pills justify-content-center mb-4 gap-2" id="adminTabs" role="tablist">

    <li class="nav-item">
        <button class="nav-link active px-4"
                id="users-tab"
                data-bs-toggle="tab"
                data-bs-target="#users"
                type="button">
            <i class="bi bi-people me-1"></i>
            Users
        </button>
    </li>

</ul>

{# ===========================
   Tab Content
   =========================== #}
<div class="tab-content">

    {# ================= USERS TAB ================= #}
    <div class="tab-pane fade show active" id="users">

        <div class="p-4 rounded-4"
             style="background: rgba(255,255,255,0.55);
                    backdrop-filter: blur(10px);
                    border: 1px solid rgba(255,255,255,0.4);">

            {# Section header #}
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">

                <h5 class="mb-2 mb-md-0">
                    <i class="bi bi-people me-2"></i>
                    Manage Users
                </h5>

                <a href="{{ path('admin_users_list') }}"
                   class="btn btn-custom btn-sm">
                    View all users
                </a>

            </div>

            {# Users list #}
            {% if users is not empty %}

                <div class="list-group list-group-flush">

                    {% for user in users %}
                        <div class="list-group-item px-0 py-3 border-top">

                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">

                                <div class="text-break">
                                    <div class="fw-semibold">
                                        {{ user.email }}
                                    </div>

                                    <small class="text-muted">
                                        {{ user.roles|join(', ') }}
                                    </small>
                                </div>

                                <div class="mt-2 mt-md-0">
                                    <span class="badge bg-light text-dark">
                                        User
                                    </span>
                                </div>

                            </div>

                        </div>
                    {% endfor %}

                </div>

            {% else %}

                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                    No users found.
                </div>

            {% endif %}

        </div>

    </div>

</div>

{% endblock %}