{% extends 'base.html.twig' %}

{% block title %}Edit User Roles{% endblock %}

{% block body %}

{# ===========================
   Header
   =========================== #}
<div class="mb-4 text-center">
    <h2 class="fw-bold mb-1">
        Edit Roles
    </h2>

    <div class="text-muted small">
        {{ user.email }}
    </div>
</div>

{# ===========================
   Flash Messages
   =========================== #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} shadow-sm">{{ message }}</div>
    {% endfor %}
{% endfor %}

{# ===========================
   Form Container
   =========================== #}
<div class="mx-auto" style="max-width: 500px;">

    <div class="p-4 rounded-4"
         style="background: rgba(255,255,255,0.55);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255,255,255,0.4);">

        {{ form_start(form) }}

        {# Roles #}
        <div class="mb-3">

            <label class="form-label small text-muted">
                User Roles
            </label>

            <div class="d-flex flex-column gap-2 mt-2">

                {% for child in form.roles %}
                    <label class="form-check d-flex align-items-center gap-2 p-2 rounded-3"
                           style="background: rgba(0,0,0,0.02); cursor:pointer;">

                        {{ form_widget(child, {
                            attr: {
                                class: 'form-check-input'
                                    ~ (child.vars.errors|length ? ' is-invalid' : '')
                            }
                        }) }}

                        <span class="small fw-semibold">
                            {{ form_label(child) }}
                        </span>

                    </label>
                {% endfor %}

            </div>

            {% for error in form.roles.vars.errors %}
                <div class="invalid-feedback d-block">
                    {{ error.message }}
                </div>
            {% endfor %}

        </div>

        {# Actions #}
        <div class="d-flex flex-column gap-2 mt-4">

            <button type="submit" class="btn btn-custom">
                <i class="bi bi-check-lg me-1"></i>
                Save Changes
            </button>

            <a href="{{ path('admin_users_list') }}"
               class="btn btn-outline-secondary">
                ← Back to Users
            </a>

        </div>

        {{ form_end(form) }}

    </div>

</div>

{% endblock %}