<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Entity\Payment" table="payment" repository-class="App\Repository\PaymentRepository">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>
        <field name="amount" type="decimal" column="amount" precision="10" scale="2" nullable="false"/>
        <field name="baseAmount" type="decimal" column="base_amount" precision="10" scale="2" nullable="true"/>
        <field name="discountApplied" type="decimal" column="discount_applied" precision="5" scale="2" nullable="true"/>
        <field name="currency" type="string" column="currency" length="3" nullable="true"/>
        <field name="status" type="string" column="status" length="20" nullable="false"/>
        <field name="transactionId" type="string" column="transaction_id" length="50" nullable="true"/>
        <field name="paymentMethod" type="string" column="payment_method" length="50" nullable="true"/>
        <field name="failureReason" type="string" column="failure_reason" length="255" nullable="true"/>
        <field name="createdAt" type="datetime_immutable" column="created_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
        <one-to-one field="invoice" target-entity="App\Entity\Invoice" mapped-by="payment">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-one>
        <many-to-one field="user" target-entity="App\Entity\User" inversed-by="payments">
            <join-column name="user_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <many-to-one field="subscription" target-entity="App\Entity\Subscription" inversed-by="payments">
            <join-column name="subscription_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>